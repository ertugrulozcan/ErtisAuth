<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Ertis.Extensions.AspNetCore" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\ErtisAuth.Analyzers\ErtisAuth.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\ErtisAuth.Extensions.ApplicationInsights\ErtisAuth.Extensions.ApplicationInsights.csproj" />
        <ProjectReference Include="..\ErtisAuth.Extensions.AspNetCore\ErtisAuth.Extensions.AspNetCore.csproj" />
        <ProjectReference Include="..\ErtisAuth.Extensions.Database\ErtisAuth.Extensions.Database.csproj" />
        <ProjectReference Include="..\ErtisAuth.Extensions.Prometheus\ErtisAuth.Extensions.Prometheus.csproj" />
        <ProjectReference Include="..\ErtisAuth.Infrastructure\ErtisAuth.Infrastructure.csproj" />
    </ItemGroup>
</Project>