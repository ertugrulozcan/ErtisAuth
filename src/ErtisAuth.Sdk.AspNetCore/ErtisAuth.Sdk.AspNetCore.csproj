<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>ErtisAuth.Sdk.AspNetCore</PackageId>
		<PackageVersion>10.0.1</PackageVersion>
		<Version>10.0.1</Version>
		<Authors>Ertuğrul Özcan</Authors>
		<Description>ErtisAuth SDK AspNetCore Extension</Description>
		<PackageTags>authentication;authorization;identity;iam;openid-connect;oauth</PackageTags>
		<Copyright>© 2026 Ertuğrul Özcan</Copyright>
		<PackageProjectUrl>https://github.com/ertugrulozcan/ErtisAuth</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ertugrulozcan/ErtisAuth</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\ErtisAuth.Extensions.Authorization\ErtisAuth.Extensions.Authorization.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\ErtisAuth.Sdk\ErtisAuth.Sdk.csproj" PrivateAssets="all" />
	</ItemGroup>
	
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>
	
	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
		</ItemGroup>
	</Target>
	
	<!-- Analyzers do not flow to consumers through package dependencies, so the analyzer is shipped inside this package -->
	<ItemGroup>
		<ProjectReference Include="..\ErtisAuth.Analyzers\ErtisAuth.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\ErtisAuth.Analyzers\bin\$(Configuration)\netstandard2.0\ErtisAuth.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
</Project>
